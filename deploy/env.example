# Copy to /opt/raspollob/<environment>/.env on the VPS and fill in real values.
# Never commit the filled-in file. Keep comments on their own lines.

# ── Stack ──────────────────────────────────────────────────────────────
# production | staging
APP_ENV=production
# Lower-case GitHub user or organisation that owns the repository
IMAGE_OWNER=your-github-username
# main for production, develop for staging (each deploy overrides it with the commit id)
IMAGE_TAG=main
# Staging: GUI_PORT=3001 and SERVER_PORT=8086
GUI_PORT=3000
SERVER_PORT=8085

# ── Database (use a separate Neon branch for staging) ──────────────────
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ── Security ───────────────────────────────────────────────────────────
# A new value per environment: openssl rand -base64 48
JWT_SECRET=

# ── App ────────────────────────────────────────────────────────────────
# Staging: https://staging.raspollob.com
FRONTEND_URL=https://raspollob.com
JPA_SHOW_SQL=false
