# Store text with LF line endings in Git
* text=auto

# Must stay LF: they run on Linux (CI runners, Docker, the VPS)
*.sh       text eol=lf
mvnw       text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.conf     text eol=lf

# Windows-only scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.jar  binary
